# Kisan Voice Assistant Configuration

# LLM Provider Configuration ("ollama" or "anthropic")
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Mandi API (Agmarknet data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# RAG & Embedding Config
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
USE_RERANKER=false
CHROMA_PERSIST_DIR=./data/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RAG_TOP_K=4
DEVICE=cpu

# Speech STT & TTS
WHISPER_MODEL_SIZE=small
TTS_FALLBACK_OFFLINE=false
